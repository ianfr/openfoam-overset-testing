FoamFile { format ascii; class dictionary; object fvSolution; }

solvers
{
    cellDisplacement
    {
        solver PCG;
        preconditioner DIC;
        tolerance 1e-8;
        relTol 0;
    }
    p
    {
        solver PBiCGStab;
        preconditioner DILU;
        tolerance 1e-7;
        relTol 0.05;
    }
    pFinal
    {
        $p;
        relTol 0;
    }
    pcorr
    {
        solver PCG;
        preconditioner DIC;
        tolerance 1e-7;
        relTol 0;
    }
    pcorrFinal { $pcorr; }
    "(U|k|omega)"
    {
        solver smoothSolver;
        smoother symGaussSeidel;
        tolerance 1e-7;
        relTol 0.05;
    }
    "(U|k|omega)Final"
    {
        $U;
        relTol 0;
    }
}

PIMPLE
{
    momentumPredictor yes;
    nOuterCorrectors 2;
    nCorrectors 2;
    nNonOrthogonalCorrectors 1;
    correctPhi yes;
    checkMeshCourantNo yes;
}

relaxationFactors
{
    equations { ".*" 1; }
}
