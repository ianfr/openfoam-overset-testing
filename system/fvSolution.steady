FoamFile { format ascii; class dictionary; object fvSolution; }

solvers
{
    cellDisplacement
    {
        solver PCG;
        preconditioner DIC;
        tolerance 1e-8;
        relTol 0;
    }
    p
    {
        solver PBiCGStab;
        preconditioner DILU;
        tolerance 1e-7;
        relTol 0.05;
    }
    "(U|k|omega)"
    {
        solver smoothSolver;
        smoother symGaussSeidel;
        tolerance 1e-7;
        relTol 0.05;
        nSweeps 1;
    }
}

SIMPLE
{
    momentumPredictor yes;
    nNonOrthogonalCorrectors 1;
    consistent yes;
}

relaxationFactors
{
    fields { p 0.3; }
    equations { "(U|k|omega)" 0.7; }
}

cache { grad(U); }
